// ─────────────────────────────────────────────────────────────
// Вспомогательные функции
// ─────────────────────────────────────────────────────────────

function formatRuDate(dateStr: string): string {
  const d = new Date(dateStr + "T00:00:00");
  if (Number.isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString("ru-RU", { day: "2-digit", month: "2-digit", year: "numeric" });
}

// Циклическая палитра для бейджей категорий — не завязана на конкретный список категорий,
// поэтому новая категория с бэкенда получит цвет автоматически.
const CATEGORY_PALETTE = [
  "bg-blue-50 text-blue-700 ring-blue-200",
  "bg-green-50 text-green-700 ring-green-200",
  "bg-amber-50 text-amber-700 ring-amber-200",
  "bg-violet-50 text-violet-700 ring-violet-200",
  "bg-rose-50 text-rose-700 ring-rose-200",
  "bg-cyan-50 text-cyan-700 ring-cyan-200",
  "bg-orange-50 text-orange-700 ring-orange-200",
];

function categoryStyle(category: string): string {
  let hash = 0;
  for (let i = 0; i < category.length; i++) hash = (hash * 31 + category.charCodeAt(i)) % CATEGORY_PALETTE.length;
  return CATEGORY_PALETTE[Math.abs(hash)];
}

// ─────────────────────────────────────────────────────────────
// Компонент страницы
// ─────────────────────────────────────────────────────────────

export function SuppliersPage({ onNavigate }: { onNavigate?: (p: Page) => void }) {
  const [suppliers, setSuppliers] = useState<Supplier[]>(SUPPLIERS_MOCK);
  const [loading, setLoading] = useState(false);
  const [search, setSearch] = useState("");
  const [selectedId, setSelectedId] = useState<number | null>(SUPPLIERS_MOCK[0]?.id ?? null);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);

    fetch("http://localhost:8000/api/v1/suppliers/with-deliveries", { credentials: "include" })
      .then((res) => {
        if (!res.ok) throw new Error(`Ошибка загрузки поставщиков: ${res.status}`);
        return res.json();
      })
      .then((data: Supplier[]) => {
        if (!cancelled && Array.isArray(data) && data.length > 0) {
          setSuppliers(data);
          setSelectedId((prev) => prev ?? data[0]?.id ?? null);
        }
      })
      .catch((err) => {
        // Бэкенд для этого раздела ещё не подключен — остаёмся на демо-данных,
        // чтобы страница оставалась рабочей и её можно было показать.
        console.warn("Поставщики: используются демо-данные:", err?.message ?? err);
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });

    return () => {
      cancelled = true;
    };
  }, []);

  const filteredSuppliers = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return suppliers;
    return suppliers.filter(
      (s) => s.name.toLowerCase().includes(q) || s.category.toLowerCase().includes(q)
    );
  }, [suppliers, search]);

  const selectedSupplier = suppliers.find((s) => s.id === selectedId) ?? null;

  const sortedDeliveries = useMemo(() => {
    if (!selectedSupplier) return [];
    return [...selectedSupplier.deliveries].sort((a, b) =>
      a.date + a.time < b.date + b.time ? 1 : -1
    );
  }, [selectedSupplier]);

  // ── Сводная статистика для верхних карточек ──
  const totalSuppliers = suppliers.length;
  const totalCategories = useMemo(() => new Set(suppliers.map((s) => s.category)).size, [suppliers]);
  const deliveries30d = useMemo(() => {
    const cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - 30);
    return suppliers.reduce(
      (sum, s) => sum + s.deliveries.filter((d) => new Date(d.date + "T00:00:00") >= cutoff).length,
      0
    );
  }, [suppliers]);

  return (
    <PageWrap
      title="Новые поставщики"
      subtitle="История сотрудничества: что, когда и в каком объёме было получено"
    >
      <div className="grid grid-cols-3 gap-4 mb-6">
        <StatCard
          label="Всего поставщиков"
          value={String(totalSuppliers)}
          sub="С историей поставок"
          icon={Building2}
        />
        <StatCard
          label="Поставок за 30 дней"
          value={String(deliveries30d)}
          sub="По всем поставщикам"
          icon={Truck}
          iconColor="text-green-500"
          iconBg="bg-green-50"
        />
        <StatCard
          label="Категорий закупок"
          value={String(totalCategories)}
          sub="Направления снабжения"
          icon={Boxes}
          iconColor="text-violet-500"
          iconBg="bg-violet-50"
        />
      </div>

      <div className="grid grid-cols-[360px_1fr] gap-4 items-start">
        {/* ── Список поставщиков + поиск ── */}
        <div className="bg-white rounded-lg border border-[#E2E8F0] overflow-hidden">
          <div className="p-3 border-b border-[#E2E8F0] bg-slate-50/60">
            <div className="relative">
              <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
              <input
                type="text"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="Найти поставщика по названию..."
                className="w-full pl-8 pr-3 py-2 border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:border-[#2563EB] focus:ring-1 focus:ring-[#2563EB] bg-white"
              />
            </div>
          </div>

          <div className="max-h-[600px] overflow-y-auto divide-y divide-[#E2E8F0]">
            {loading && suppliers.length === 0 ? (
              <div className="px-4 py-10 text-center">
                <p className="text-sm text-slate-400">Загрузка поставщиков...</p>
              </div>
            ) : filteredSuppliers.length === 0 ? (
              <div className="px-4 py-10 text-center">
                <Inbox size={22} className="text-slate-300 mx-auto mb-2" />
                <p className="text-sm text-slate-400">Поставщик не найден</p>
              </div>
            ) : (
              filteredSuppliers.map((s) => {
                const isActive = s.id === selectedId;
                const lastDelivery = [...s.deliveries].sort((a, b) => (a.date < b.date ? 1 : -1))[0];
                return (
                  <button
                    key={s.id}
                    onClick={() => setSelectedId(s.id)}
                    className={`w-full text-left px-4 py-3 transition-colors flex items-center justify-between gap-2 ${
                      isActive
                        ? "bg-blue-50/60 border-l-2 border-l-[#2563EB]"
                        : "hover:bg-slate-50/60 border-l-2 border-l-transparent"
                    }`}
                  >
                    <div className="min-w-0">
                      <p className={`text-sm font-medium truncate ${isActive ? "text-[#2563EB]" : "text-slate-800"}`}>
                        {s.name}
                      </p>
                      <div className="flex items-center gap-2 mt-1">
                        <span className={`text-[11px] font-medium px-1.5 py-0.5 rounded ring-1 ${categoryStyle(s.category)}`}>
                          {s.category}
                        </span>
                        {lastDelivery && (
                          <span className="text-[11px] text-slate-400">посл. {formatRuDate(lastDelivery.date)}</span>
                        )}
                      </div>
                    </div>
                    <ChevronRight size={14} className={isActive ? "text-[#2563EB]" : "text-slate-300"} />
                  </button>
                );
              })
            )}
          </div>
        </div>

        {/* ── Карточка поставщика ── */}
        <div>
          {!selectedSupplier ? (
            <div className="bg-white rounded-lg border border-[#E2E8F0] flex flex-col items-center justify-center py-24 text-center">
              <Truck size={28} className="text-slate-300 mb-3" />
              <p className="text-sm text-slate-500">Выберите поставщика слева,</p>
              <p className="text-sm text-slate-500">чтобы увидеть историю поставок</p>
            </div>
          ) : (
            <>
              {/* Шапка карточки: реквизиты + сводка */}
              <div className="bg-white rounded-lg border border-[#E2E8F0] p-5 mb-4">
                <div className="flex items-center gap-2 mb-1">
                  <h3 className="text-base font-semibold text-slate-900">{selectedSupplier.name}</h3>
                  <span className={`text-xs font-medium px-2 py-0.5 rounded ring-1 ${categoryStyle(selectedSupplier.category)}`}>
                    {selectedSupplier.category}
                  </span>
                </div>

                <div className="flex items-center flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500 mb-4">
                  {selectedSupplier.contactPerson && (
                    <span className="flex items-center gap-1"><User size={11} />{selectedSupplier.contactPerson}</span>
                  )}
                  {selectedSupplier.phone && (
                    <span className="flex items-center gap-1"><Phone size={11} />{selectedSupplier.phone}</span>
                  )}
                  {selectedSupplier.email && (
                    <span className="flex items-center gap-1"><Mail size={11} />{selectedSupplier.email}</span>
                  )}
                </div>

                <div className="grid grid-cols-3 gap-3 pt-3 border-t border-slate-100">
                  <div>
                    <p className="text-[11px] text-slate-400 uppercase tracking-wide mb-0.5">Поставок всего</p>
                    <p className="text-sm font-semibold text-slate-800">{selectedSupplier.deliveries.length}</p>
                  </div>
                  <div>
                    <p className="text-[11px] text-slate-400 uppercase tracking-wide mb-0.5">Позиций получено</p>
                    <p className="text-sm font-semibold text-slate-800">
                      {selectedSupplier.deliveries.reduce((sum, d) => sum + d.items.length, 0)}
                    </p>
                  </div>
                  <div>
                    <p className="text-[11px] text-slate-400 uppercase tracking-wide mb-0.5">Последняя поставка</p>
                    <p className="text-sm font-semibold text-slate-800">
                      {sortedDeliveries[0] ? formatRuDate(sortedDeliveries[0].date) : "—"}
                    </p>
                  </div>
                </div>
              </div>

              {/* История поставок */}
              <SectionHeader title="История поставок" />
              <div className="space-y-3">
                {sortedDeliveries.map((delivery) => (
                  <div key={delivery.id} className="bg-white rounded-lg border border-[#E2E8F0] overflow-hidden">
                    <div className="px-4 py-2.5 bg-slate-50/60 border-b border-[#E2E8F0] flex items-center justify-between">
                      <div className="flex items-center gap-4 text-xs">
                        <span className="flex items-center gap-1.5 font-medium text-slate-800">
                          <Calendar size={12} className="text-[#2563EB]" />{formatRuDate(delivery.date)}
                        </span>
                        <span className="flex items-center gap-1.5 text-slate-600">
                          <Clock size={12} className="text-slate-400" />{delivery.time}
                        </span>
                        {delivery.invoiceNumber && (
                          <span className="flex items-center gap-1.5 text-slate-400">
                            <FileText size={12} />{delivery.invoiceNumber}
                          </span>
                        )}
                      </div>
                      <span className="text-[11px] text-slate-400">{delivery.items.length} поз.</span>
                    </div>
                    <table className="w-full border-collapse">
                      <thead>
                        <tr className="border-b border-[#E2E8F0]">
                          <th className="px-4 py-2 text-[11px] font-medium text-slate-400 uppercase tracking-wide text-left">
                            Товар
                          </th>
                          <th className="px-4 py-2 text-[11px] font-medium text-slate-400 uppercase tracking-wide text-right">
                            Количество
                          </th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-[#E2E8F0]">
                        {delivery.items.map((item) => (
                          <tr key={item.id} className="hover:bg-slate-50/50 transition-colors">
                            <td className="px-4 py-2 text-sm text-slate-700">{item.productName}</td>
                            <td className="px-4 py-2 text-sm font-mono text-slate-700 text-right">
                              {item.quantity.toLocaleString("ru-RU")} {item.unit}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    </PageWrap>
  );
}